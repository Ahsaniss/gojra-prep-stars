{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && npm run vercel:prepare",
  "functions": {
    "api/index.ts": {
      "includeFiles": ["dist/**", "public/**"]
    },
    "api/[...path].ts": {
      "includeFiles": ["dist/**", "public/**"]
    }
  },
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "^/$",
      "dest": "/api"
    },
    {
      "src": "^/(.*)$",
      "dest": "/api/$1"
    }
  ]
}
