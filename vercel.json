{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build && npm run vercel:prepare",
  "functions": {
    "api/index.ts": {
      "includeFiles": "dist/**"
    },
    "api/[...path].ts": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api"
    },
    {
      "source": "/assets/:path*",
      "destination": "/api/assets/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/api/:path*"
    }
  ]
}
